{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "wing",
	"patterns": [
		{ "include": "#keywords" },
		{ "include": "#numbers" },
		{ "include": "#preprocessor"},
		{ "include": "#storage"},
		{ "include": "#constant"}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.wing",
					"match": "\\b(if|while|for|return|switch}case)\\b"
				},
				{
					"name": "keyword.control.wing",
					"match": "\\b(if|while|for|return|switch}case)\\b"
				}
			]
		},
		"storage":{
			"patterns": [
				{
					"name": "storage.type.wing",
					"match": "\\b(none|i8|i16|i32|i64|ch)\\b"
				},
				{
					"name": "storage.type.function",
					"match": "\\b(fn)\\b"
				},
				{
					"name": "storage.modiifer.pointer.wing",
					"match": "\\b(point|address)\\b"
				}
			]
		},
		"constant":{
			"patterns": [
				{
					"name": "constant.language.null.wing",
					"match": "\\b(null)\\b"
				}
			]
		},
		"numbers":{
			"patterns":[
				{
					"name": "constat.numeric.integer.wing",
					"match": "\\b[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
				}
			]
		},
		"preprocessor":{
			"patterns": [
			{
			"name": "meta.preprocessor.mylang",
			"begin": "^\\s*(!)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.directive.mylang" },
				"2": { "name": "keyword.control.directive.mylang" }
			},
			"end": "(?<!\\\\)$",
			"patterns": [
				{ "include": "#strings" },
				{ "include": "#numbers" },
				{ "include": "#comments" }
			]
			}
		]
		}
	},
	"scopeName": "source.wing"
}